{
  "name": "dsh-hema",
  "version": "0.1.0",
  "description": "大案组·何马 agent preset for DeepSeek Harness — registers a 'hema' mode in the session mode dropdown, persona text in presets/hema/hema-persona.md.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./ui": "./lib/ui.js",
    "./tools": "./lib/tools.js",
    "./lib/tools": "./lib/tools.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "agent-preset",
    "大案组",
    "何马"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dshTarget": "0.2.0-rc.2"
}
